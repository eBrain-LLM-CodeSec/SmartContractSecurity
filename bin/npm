#!/usr/bin/env bash
# Transparent shim: routes `npm` calls through the evmbench-worker.sif
# container (Node v22.23.1 / npm 10.9.8 confirmed present) so Hardhat-family
# audits (and Foundry audits with an npm-managed lib/, e.g. remappings
# pointing at node_modules/@openzeppelin) can install their dependencies on
# this host, mirroring the bin/forge shim's bind-$PWD-read-write pattern.
set -euo pipefail
SIF=/scratch/md5344/evmbench/containers/evmbench-worker.sif
# npm needs a writable $HOME (npm cache, .npmrc, etc.) -- reuse the same
# container-home bind bin/forge uses so both tools share one cache dir.
CONTAINER_HOME="/scratch/md5344/evmbench/agent4vul/.container_home"
mkdir -p "${CONTAINER_HOME}"

# `-H src:dest` claims to bind a container home and set $HOME to match, but
# on this Singularity build it does neither reliably -- confirmed live: with
# `-H`, $HOME reports /home/build_home but that path is never actually
# mounted (falls through to the image's own baked-in /home/, which has no
# such directory), so anything that writes to $HOME immediately (npm's
# cache/config, on every invocation) dies with ENOENT. `forge` never hit
# this because bin/forge deliberately avoids touching $HOME (`--use` instead
# of solc auto-install). A plain `--bind` + exporting $HOME ourselves inside
# the container actually works.
exec singularity exec --containall --no-home --pwd "${PWD}" \
  --bind "${CONTAINER_HOME}:/home/build_home" \
  --bind "${PWD}:${PWD}" --bind "/scratch/md5344/evmbench/agent4vul:/scratch/md5344/evmbench/agent4vul" \
  "${SIF}" bash -c 'export HOME=/home/build_home; exec npm "$@"' bash "$@"
