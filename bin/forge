#!/usr/bin/env bash
# Transparent shim: routes `forge` calls through the evmbench-worker.sif
# container (which has forge 1.7.1 baked in) so Slither's own
# `subprocess.run(["forge", ...])` calls (crytic_compile/platform/foundry.py)
# work unmodified even though `forge` isn't installed on this host directly.
# Binds the caller's $PWD (the audit checkout Slither/forge is compiling)
# read-write, same bind-per-call pattern used for the Codex invocations.
set -euo pipefail
SIF=/scratch/md5344/evmbench/containers/evmbench-worker.sif
# Several EVMbench audits pin a specific Foundry release/nightly in their
# own Dockerfile (`foundryup --install v0.3.0`, a specific nightly SHA,
# etc.) that differs from whatever forge ships baked into evmbench-worker.sif
# (1.7.1). FORGE_VERSION lets a caller select a version pre-installed under
# agent4vul/.venv/.foundry-versions/<version>/ (installed the same way
# solc-select versions are: `foundryup --install <version>` with
# FOUNDRY_DIR pointed at that directory) -- falls back to the image's
# baked-in forge if the requested version was never installed there.
FOUNDRY_VERSIONS="/scratch/md5344/evmbench/agent4vul/.venv/.foundry-versions"
FORGE_BIN_OVERRIDE=()
if [[ -n "${FORGE_VERSION:-}" ]] && [[ -x "${FOUNDRY_VERSIONS}/${FORGE_VERSION}/bin/forge" ]]; then
  FORGE_BIN_OVERRIDE=("${FOUNDRY_VERSIONS}/${FORGE_VERSION}/bin/forge")
fi
# forge/svm need a real writable $HOME (for ~/.svm solc-version cache etc.).
# SINGULARITYENV_HOME is rejected outright by this Singularity build; -H
# src:dest is the flag that actually works, binding a real host dir as the
# container's home. Shared across invocations so solc downloads are cached.
# dest must NOT be /home/agent -- that path is where the image bakes its own
# forge/foundryup binaries (~/.foundry/bin), and -H's dest shadows it.
CONTAINER_HOME="/scratch/md5344/evmbench/agent4vul/.container_home"
mkdir -p "${CONTAINER_HOME}"

# forge's own solc-version-manager (svm) tries to download/install solc under
# a home directory it resolves via a lower-level OS lookup (not the $HOME env
# var -- confirmed live: even with a valid writable -H target, "blocking
# installing solc" still hit a read-only-filesystem error, because that OS
# lookup falls back to this *host* user's real /home/md5344, which doesn't
# exist inside the container's filesystem at all). Sidestep svm entirely by
# pointing forge at an already-downloaded solc binary (via agent4vul's own
# solc-select install, under this same repo tree so it's covered by the
# --bind below) with `--use`, whenever the caller didn't already pass --use.
SOLC_SELECT_ARTIFACTS="/scratch/md5344/evmbench/agent4vul/.venv/.solc-select/artifacts"
EXTRA_ARGS=()
SUBCOMMAND="${1:-}"

# Highest-priority, explicit selection: BENCHMARK_SOLC_PATH points directly
# at a checksum-verified binary from scripts.benchmark.provision_toolchains'
# toolchain-lock.json (set per-invocation by the offline benchmark runner,
# derived from audit-build-manifest.jsonl's compiler-version resolution --
# never from this script's own foundry.toml grep). This is deliberately a
# hard failure, not a fallback, when set but missing: a benchmark run that
# declared a compiler requirement and then silently fell back to guessing
# would defeat the entire point of provisioning explicitly.
if [[ -n "${BENCHMARK_SOLC_PATH:-}" ]] && [[ "${SUBCOMMAND}" =~ ^(build|compile)$ ]] && [[ "$*" != *"--use"* ]]; then
  if [[ ! -x "${BENCHMARK_SOLC_PATH}" ]]; then
    echo "TOOLCHAIN_NOT_PROVISIONED: BENCHMARK_SOLC_PATH=${BENCHMARK_SOLC_PATH} does not exist or is not executable -- refusing to fall back to an implicit/downloaded compiler." >&2
    exit 97
  fi
  EXTRA_ARGS=(--use "${BENCHMARK_SOLC_PATH}")
fi

if [[ "${#EXTRA_ARGS[@]}" -eq 0 ]] && [[ -n "${FORGE_FORCE_SOLC:-}" ]] && [[ "${SUBCOMMAND}" =~ ^(build|compile)$ ]] && [[ "$*" != *"--use"* ]]; then
  # Caller-supplied override for projects with no single parseable pin in
  # foundry.toml (e.g. `auto_detect_solc = true`, version resolved instead
  # by scanning `pragma solidity` statements in the checkout) -- skips the
  # foundry.toml grep below entirely.
  d="${SOLC_SELECT_ARTIFACTS}/solc-${FORGE_FORCE_SOLC}"
  if [[ -d "$d" ]]; then
    EXTRA_ARGS=(--use "${d}/solc-${FORGE_FORCE_SOLC}")
  fi
fi
if [[ "${#EXTRA_ARGS[@]}" -eq 0 ]] && [[ "${SUBCOMMAND}" =~ ^(build|compile)$ ]] && [[ "$*" != *"--use"* ]]; then
  # foundry.toml pins an exact version under either key name -- `solc =
  # "0.8.17"` or `solc_version = "0.8.17"` (both are valid Foundry config,
  # confirmed live: 2024-01-canto uses the latter and was silently falling
  # through to the broken svm auto-install path below even though 0.8.17 was
  # already cached, because the old pattern only matched the `solc` key).
  # Anchored to the start of the line (after optional leading whitespace) so
  # `auto_detect_solc = false` doesn't false-match on the `solc` substring.
  for d in "${SOLC_SELECT_ARTIFACTS}"/solc-*; do
    [[ -d "$d" ]] || continue
    v="$(basename "$d" | sed 's/^solc-//')"
    if grep -qE "^[[:space:]]*solc(_version)?[[:space:]]*=[[:space:]]*[\"']${v}[\"']" foundry.toml 2>/dev/null; then
      EXTRA_ARGS=(--use "${d}/solc-${v}")
      break
    fi
  done
fi

# Strict-offline mode (set by the hermetic benchmark runner): if nothing
# above resolved an explicit --use path for a build/compile invocation,
# refuse to let forge/svm fall through to their own dynamic
# resolution-or-download behavior at all, rather than silently attempting
# network access (or hitting this container's read-only-filesystem error
# trying to). Not the default -- interactive/debugging use of this shim
# outside the benchmark's offline runner still gets the best-effort
# fallback chain above.
if [[ "${BENCHMARK_STRICT_OFFLINE:-}" == "1" ]] && [[ "${#EXTRA_ARGS[@]}" -eq 0 ]] \
   && [[ "${SUBCOMMAND}" =~ ^(build|compile)$ ]] && [[ "$*" != *"--use"* ]]; then
  echo "TOOLCHAIN_NOT_PROVISIONED: BENCHMARK_STRICT_OFFLINE=1 and no explicit compiler selection resolved (BENCHMARK_SOLC_PATH unset, FORGE_FORCE_SOLC unset, and no foundry.toml solc/solc_version pin matched a provisioned artifact) -- refusing to let forge fall back to auto-detection/download." >&2
  exit 97
fi

# For audits whose Foundry project lives in a subdirectory of the git repo
# (config.yaml's run_cmd_dir != "."), `forge install`'s internal `git
# submodule` calls need to see the repo's actual .git, which lives one or
# more levels above $PWD -- outside the `--bind $PWD:$PWD` below. Confirmed
# live: 2024-01-renft (run_cmd_dir=smart-contracts) failed `forge install`
# with "fatal: not a git repository ... Stopping at filesystem boundary",
# because only smart-contracts/ was bound, not its parent's .git. Callers
# that know the real git root set FORGE_GIT_ROOT to get it bound too.
GIT_ROOT_BIND=()
if [[ -n "${FORGE_GIT_ROOT:-}" ]]; then
  GIT_ROOT_BIND=(--bind "${FORGE_GIT_ROOT}:${FORGE_GIT_ROOT}")
fi

# See bin/npm's comment: -H's $HOME binding is unreliable on this
# Singularity build (confirmed to silently not mount/export at all) -- use
# a plain --bind + explicit export instead, same as bin/npm/bin/npx.
FORGE_CMD="forge"
if [[ "${#FORGE_BIN_OVERRIDE[@]}" -gt 0 ]]; then
  FORGE_CMD="${FORGE_BIN_OVERRIDE[0]}"
fi

exec singularity exec --containall --no-home --pwd "${PWD}" \
  --bind "${CONTAINER_HOME}:/home/build_home" \
  --bind "${PWD}:${PWD}" --bind "/scratch/md5344/evmbench/agent4vul:/scratch/md5344/evmbench/agent4vul" \
  "${GIT_ROOT_BIND[@]}" \
  "${SIF}" bash -c 'export HOME=/home/build_home; exec "$1" "${@:2}"' bash "${FORGE_CMD}" "$@" "${EXTRA_ARGS[@]}"
