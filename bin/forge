#!/usr/bin/env bash
# Transparent shim: routes `forge` calls through the evmbench-worker.sif
# container (which has forge 1.7.1 baked in) so Slither's own
# `subprocess.run(["forge", ...])` calls (crytic_compile/platform/foundry.py)
# work unmodified even though `forge` isn't installed on this host directly.
# Binds the caller's $PWD (the audit checkout Slither/forge is compiling)
# read-write, same bind-per-call pattern used for the Codex invocations.
set -euo pipefail
SIF=/scratch/md5344/evmbench/containers/evmbench-worker.sif
# forge/svm need a real writable $HOME (for ~/.svm solc-version cache etc.).
# SINGULARITYENV_HOME is rejected outright by this Singularity build; -H
# src:dest is the flag that actually works, binding a real host dir as the
# container's home. Shared across invocations so solc downloads are cached.
# dest must NOT be /home/agent -- that path is where the image bakes its own
# forge/foundryup binaries (~/.foundry/bin), and -H's dest shadows it.
CONTAINER_HOME="/scratch/md5344/evmbench/agent4vul/.container_home"
mkdir -p "${CONTAINER_HOME}"

# forge's own solc-version-manager (svm) tries to download/install solc under
# a home directory it resolves via a lower-level OS lookup (not the $HOME env
# var -- confirmed live: even with a valid writable -H target, "blocking
# installing solc" still hit a read-only-filesystem error, because that OS
# lookup falls back to this *host* user's real /home/md5344, which doesn't
# exist inside the container's filesystem at all). Sidestep svm entirely by
# pointing forge at an already-downloaded solc binary (via agent4vul's own
# solc-select install, under this same repo tree so it's covered by the
# --bind below) with `--use`, whenever the caller didn't already pass --use.
SOLC_SELECT_ARTIFACTS="/scratch/md5344/evmbench/agent4vul/.venv/.solc-select/artifacts"
EXTRA_ARGS=()
SUBCOMMAND="${1:-}"
if [[ "${SUBCOMMAND}" =~ ^(build|compile)$ ]] && [[ "$*" != *"--use"* ]]; then
  # foundry.toml pins an exact version (e.g. `solc = "0.8.17"`); reuse
  # whichever versions are already installed via `uv run solc-select install`.
  for d in "${SOLC_SELECT_ARTIFACTS}"/solc-*; do
    [[ -d "$d" ]] || continue
    v="$(basename "$d" | sed 's/^solc-//')"
    if grep -q "solc[[:space:]]*=[[:space:]]*[\"']${v}[\"']" foundry.toml 2>/dev/null; then
      EXTRA_ARGS=(--use "${d}/solc-${v}")
      break
    fi
  done
fi

exec singularity exec --containall --no-home --pwd "${PWD}" \
  -H "${CONTAINER_HOME}:/home/build_home" \
  --bind "${PWD}:${PWD}" --bind "/scratch/md5344/evmbench/agent4vul:/scratch/md5344/evmbench/agent4vul" \
  "${SIF}" forge "$@" "${EXTRA_ARGS[@]}"
